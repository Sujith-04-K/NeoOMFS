{
  "name": "neoomfs-web-selenium",
  "version": "2.0.0",
  "description": "Enterprise Selenium E2E automation suite for NeoOMFS Web Application — 400+ test cases",
  "main": "tests/e2e.test.js",
  "type": "module",
  "scripts": {
    "test": "node tests/e2e.test.js",
    "test:ci": "CI=true BASE_URL=${BASE_URL:-http://localhost:5173} node tests/e2e.test.js",
    "test:headed": "node tests/e2e.test.js",
    "report": "python ../../automation/generate_html_report.py",
    "clean": "rimraf 'Test Results'"
  },
  "dependencies": {
    "selenium-webdriver": "^4.28.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
