<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeoOMFS"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NeoOMFS.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.OnboardingActivity1"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.OnboardingActivity2"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.OnboardingActivity3"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.ResetPasswordActivity"
            android:exported="true"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="neoomfs" android:host="reset-password" />
                <data android:scheme="neoomfs" android:host="reset-password" android:pathPrefix="/" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.PatientLogActivity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.PatientRegistrationActivity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.OMFSWizardActivity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.SignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.OMFSWizardStep2Activity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.OMFSWizardStep3Activity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.OMFSWizardStep4Activity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.OMFSWizardStep5Activity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.OMFSWizardStep6Activity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.OMFSWizardStep7Activity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.OMFSWizardStep8Activity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.NeoOMFS"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>