<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:fitsSystemWindows="true" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".activities.OMFSWizardStep4Activity">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingVertical="8dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_card_dark_blue"
                android:padding="8dp"
                android:src="@drawable/ic_logo_pin"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OMFS Guided Wizard"
                    android:textColor="@color/bg_dark_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLINICAL TRIAGE SYSTEM"
                    android:textColor="@color/accent_blue"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Current Step Badge -->
        <TextView
            android:id="@+id/tvStepBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Step 4/8"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Top Blue Progress Bar -->
    <ProgressBar
        android:id="@+id/wizardProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="800"
        android:progress="400"
        android:progressTint="@color/accent_blue"
        android:progressBackgroundTint="#E2E8F0"
        app:layout_constraintTop_toBottomOf="@id/headerBar" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutActions"
        app:layout_constraintTop_toBottomOf="@id/wizardProgressBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 4: LAB INVESTIGATIONS"
                android:textColor="@color/text_secondary_gray"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Card 1: Blood Group Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnWhyBloodGroup">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Blood Group ⓘ"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Status Text -->
                    <TextView
                        android:id="@+id/tvBloodGroupStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Not selected"
                        android:textColor="@color/text_secondary_gray"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Why dropdown info -->
                <LinearLayout
                    android:id="@+id/layoutWhyBloodGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F8FAFC"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Why is this required preoperatively?"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Knowing the patient's ABO and Rh blood group is essential in case of unforeseen blood loss during major oral or maxillofacial procedures requiring emergency transfusion."
                        android:textColor="@color/text_secondary_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etBloodGroup"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Enter Blood Group (e.g. O+)"
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Card 2: Sugar Levels (RBS / FBS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnWhySugar">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Glucose Levels (RBS / FBS) ⓘ"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View
                            android:id="@+id/dotSugar"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_chip_green"
                            android:backgroundTint="@color/status_green" />
                        <TextView
                            android:id="@+id/tvSugarStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Normal"
                            android:textColor="@color/status_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Why dropdown info -->
                <LinearLayout
                    android:id="@+id/layoutWhySugar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F8FAFC"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Why is this required preoperatively?"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Preoperative diabetes/hyperglycemia reduces surgical wound healing capacity, increases the susceptibility to localized or systemic infections, and alters pharmacological management. Normal Range:\n• RBS: 70 - 140 mg/dL\n• FBS: 70 - 100 mg/dL"
                        android:textColor="@color/text_secondary_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- RBS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Random Blood Sugar (RBS)"
                            android:textColor="@color/text_secondary_gray"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etRbs"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_edit_text"
                            android:hint="mg/dL"
                            android:textColorHint="@color/text_light_gray"
                            android:inputType="number"
                            android:paddingHorizontal="16dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- FBS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fasting Blood Sugar (FBS)"
                            android:textColor="@color/text_secondary_gray"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etFbs"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_edit_text"
                            android:hint="mg/dL"
                            android:textColorHint="@color/text_light_gray"
                            android:inputType="number"
                            android:paddingHorizontal="16dp"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: BT / CT (Bleeding Time / Clotting Time) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnWhyBtCt">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Bleeding &amp; Clotting Time (BT/CT) ⓘ"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View
                            android:id="@+id/dotBtCt"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_chip_green"
                            android:backgroundTint="@color/status_green" />
                        <TextView
                            android:id="@+id/tvBtCtStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Normal"
                            android:textColor="@color/status_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Why dropdown info -->
                <LinearLayout
                    android:id="@+id/layoutWhyBtCt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F8FAFC"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Why is this required preoperatively?"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="BT screens platelet integrity and primary vascular homeostasis, while CT screens internal clotting mechanism pathways. Essential to prevent major hemorrhage during surgery. Normal Range:\n• Bleeding Time (BT): 2 - 7 mins\n• Clotting Time (CT): 5 - 15 mins"
                        android:textColor="@color/text_secondary_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- BT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bleeding Time (BT)"
                            android:textColor="@color/text_secondary_gray"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etBt"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_edit_text"
                            android:hint="mins"
                            android:textColorHint="@color/text_light_gray"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="16dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- CT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clotting Time (CT)"
                            android:textColor="@color/text_secondary_gray"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etCt"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_edit_text"
                            android:hint="mins"
                            android:textColorHint="@color/text_light_gray"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="16dp"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 4: Complete Blood Count (CBC) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnWhyCbc">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Complete Blood Count (CBC) ⓘ"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View
                            android:id="@+id/dotCbc"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_chip_green"
                            android:backgroundTint="@color/status_green" />
                        <TextView
                            android:id="@+id/tvCbcStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Normal"
                            android:textColor="@color/status_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Why dropdown info -->
                <LinearLayout
                    android:id="@+id/layoutWhyCbc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F8FAFC"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Why is this required preoperatively?"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Assesses total health status. Hemoglobin rules out systemic anemia, WBC screens for infectious reactions, and Platelets rule out severe thrombocytopenia. Normal Ranges:\n• Hemoglobin: 12.0 - 17.5 g/dL\n• WBC: 4,000 - 11,000 /µL\n• Platelets: 150,000 - 450,000 /µL"
                        android:textColor="@color/text_secondary_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Hemoglobin -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Hemoglobin"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etHb"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="g/dL"
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp" />

                <!-- WBC -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="White Blood Cell Count (WBC)"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etWbc"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="cells/µL"
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp" />

                <!-- Platelets -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Platelet Count"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etPlatelets"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="cells/µL"
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Card 5: PT / INR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnWhyPtInr">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Prothrombin Time / INR (PT/INR) ⓘ"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View
                            android:id="@+id/dotPtInr"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_chip_green"
                            android:backgroundTint="@color/status_green" />
                        <TextView
                            android:id="@+id/tvPtInrStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Normal"
                            android:textColor="@color/status_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Why dropdown info -->
                <LinearLayout
                    android:id="@+id/layoutWhyPtInr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F8FAFC"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Why is this required preoperatively?"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Measures the extrinsic pathway of coagulation. Mandatory for patients on oral anticoagulants (warfarin) or with chronic liver disease to assess surgical bleeding index. Normal Range:\n• PT: 11 - 13.5 secs\n• INR: 0.8 - 1.2"
                        android:textColor="@color/text_secondary_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- PT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prothrombin Time (PT)"
                            android:textColor="@color/text_secondary_gray"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etPt"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_edit_text"
                            android:hint="seconds"
                            android:textColorHint="@color/text_light_gray"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="16dp"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- INR -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INR Value"
                            android:textColor="@color/text_secondary_gray"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etInr"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_edit_text"
                            android:hint="e.g. 1.0"
                            android:textColorHint="@color/text_light_gray"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="16dp"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:paddingVertical="8dp"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar">

        <!-- Back Button -->
        <LinearLayout
            android:id="@+id/btnWizardBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:paddingVertical="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:id="@+id/tvWizardBackText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Previous"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Next step Button -->
        <LinearLayout
            android:id="@+id/btnWizardNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:paddingVertical="8dp"
            android:layout_weight="1.3"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_button_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWizardNextText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next step →"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnWizardSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:paddingHorizontal="16dp"
        android:text="Skip this step →"
        android:textColor="@color/text_secondary_gray"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnWizardNext" />

    <!-- Bottom Navigation Bar (Assess Active) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Dashboard -->
        <FrameLayout
            android:id="@+id/btnNavDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/text_light_gray" />
        </FrameLayout>

        <!-- Patients -->
        <FrameLayout
            android:id="@+id/btnNavPatients"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_people"
                app:tint="@color/text_light_gray" />
        </FrameLayout>

        <!-- Assess -->
        <LinearLayout
            android:id="@+id/btnNavAssess"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_nav_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_assess"
                app:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Assess"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Settings -->
        <FrameLayout
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/text_light_gray" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
