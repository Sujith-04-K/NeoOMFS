<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:fitsSystemWindows="true" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".activities.OMFSWizardStep5Activity">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingVertical="8dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_card_dark_blue"
                android:padding="8dp"
                android:src="@drawable/ic_logo_pin"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OMFS Guided Wizard"
                    android:textColor="@color/bg_dark_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLINICAL TRIAGE SYSTEM"
                    android:textColor="@color/accent_blue"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Current Step Badge -->
        <TextView
            android:id="@+id/tvStepBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Step 5/8"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Top Blue Progress Bar -->
    <ProgressBar
        android:id="@+id/wizardProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="800"
        android:progress="500"
        android:progressTint="@color/accent_blue"
        android:progressBackgroundTint="#E2E8F0"
        app:layout_constraintTop_toBottomOf="@id/headerBar" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutActions"
        app:layout_constraintTop_toBottomOf="@id/wizardProgressBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 5: MEDICAL HISTORY &amp; RISK ASSESSMENT"
                android:textColor="@color/text_secondary_gray"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Card 1: Lifestyle factors -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnWhyLifestyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Lifestyle Factors ⓘ"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Why dropdown info -->
                <LinearLayout
                    android:id="@+id/layoutWhyLifestyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F8FAFC"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Why check Lifestyle parameters?"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Smoking causes microvascular constriction, compromising bone and soft tissue graft vascularity. Alcohol alters hepatic microsomal activity and sedation responses, while nutritional deficiency directly impairs tissue regeneration."
                        android:textColor="@color/text_secondary_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Smoking checkbox -->
                    <CheckBox
                        android:id="@+id/cbSmoking"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Smoking History"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="13sp" />

                    <!-- Alcohol checkbox -->
                    <CheckBox
                        android:id="@+id/cbAlcohol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Alcohol Use"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Diet Info Dropdown Spinner -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Dietary Classification"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp" />

                <RelativeLayout
                    android:id="@+id/spinnerDiet"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/tvSelectedDiet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Normal Mixed Diet"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="▼"
                        android:textColor="@color/text_secondary_gray"
                        android:textSize="12sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Card 2: Medical History Checklist -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnWhyMedicalHistory">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Systemic Medical History ⓘ"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Why dropdown info -->
                <LinearLayout
                    android:id="@+id/layoutWhyMedicalHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F8FAFC"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Why screen medical history?"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Cardiac disease alters local anesthetic containing epinephrine protocols. Hypertension causes intraoperative bleeding risks. Asthma or lung issues increase respiratory spasm risks under anesthesia. Bleeding disorders alter hemostatic agent requirements. Drug allergies prevent toxic anaphylaxis."
                        android:textColor="@color/text_secondary_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="2">

                    <CheckBox
                        android:id="@+id/cbDiabetes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diabetes"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="13sp"
                        android:layout_columnWeight="1" />

                    <CheckBox
                        android:id="@+id/cbHypertension"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hypertension"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="13sp"
                        android:layout_columnWeight="1" />

                    <CheckBox
                        android:id="@+id/cbAsthma"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asthma"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="13sp"
                        android:layout_columnWeight="1" />

                    <CheckBox
                        android:id="@+id/cbCardiac"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cardiac Disease"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="13sp"
                        android:layout_columnWeight="1" />

                    <CheckBox
                        android:id="@+id/cbBleeding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bleeding Disorder"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="13sp"
                        android:layout_columnWeight="1" />

                    <CheckBox
                        android:id="@+id/cbKidney"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kidney Disease"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="13sp"
                        android:layout_columnWeight="1" />

                    <CheckBox
                        android:id="@+id/cbLiver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Liver Disease"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="13sp"
                        android:layout_columnWeight="1" />

                    <CheckBox
                        android:id="@+id/cbPregnancy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pregnancy"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="13sp"
                        android:layout_columnWeight="1" />
                </GridLayout>

                <!-- Drug allergy checkbox + extra field -->
                <CheckBox
                    android:id="@+id/cbDrugAllergy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Drug Allergies"
                    android:textColor="@color/bg_dark_blue"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etAllergyDetails"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Specify allergic agents (e.g. Sulfa)"
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Card 3: Medications Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnWhyMedications">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Medication Section ⓘ"
                        android:textColor="@color/bg_dark_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Why dropdown info -->
                <LinearLayout
                    android:id="@+id/layoutWhyMedications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#F8FAFC"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Why review current medications?"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Antiplatelet therapy (Aspirin/Clopidogrel) or anticoagulants must be temporarily altered or discontinued under physician clearance. Corticosteroids affect surgical healing and stress reserves. Knowing medications prevents harmful drug-drug interactions."
                        android:textColor="@color/text_secondary_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Inputs row to add medication -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ADD MEDICATION"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Drug Name -->
                <EditText
                    android:id="@+id/etDrugName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Drug Name (e.g. Metformin)"
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Dosage -->
                    <EditText
                        android:id="@+id/etDrugDosage"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Dosage (e.g. 500mg)"
                        android:textColorHint="@color/text_light_gray"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp" />

                    <!-- Frequency -->
                    <EditText
                        android:id="@+id/etDrugFrequency"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edit_text"
                        android:hint="Frequency (e.g. 1-0-1)"
                        android:textColorHint="@color/text_light_gray"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Add Button -->
                <LinearLayout
                    android:id="@+id/btnAddMedication"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Add Medication to List"
                        android:textColor="@color/accent_blue"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Dynamic Container -->
                <LinearLayout
                    android:id="@+id/layoutMedicationsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:paddingVertical="8dp"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar">

        <!-- Back Button -->
        <LinearLayout
            android:id="@+id/btnWizardBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:paddingVertical="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:id="@+id/tvWizardBackText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Previous"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Next step Button -->
        <LinearLayout
            android:id="@+id/btnWizardNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:paddingVertical="8dp"
            android:layout_weight="1.3"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_button_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWizardNextText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next step →"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Navigation Bar (Assess Active) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Dashboard -->
        <FrameLayout
            android:id="@+id/btnNavDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/text_light_gray" />
        </FrameLayout>

        <!-- Patients -->
        <FrameLayout
            android:id="@+id/btnNavPatients"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_people"
                app:tint="@color/text_light_gray" />
        </FrameLayout>

        <!-- Assess -->
        <LinearLayout
            android:id="@+id/btnNavAssess"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_nav_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_assess"
                app:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Assess"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Settings -->
        <FrameLayout
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/text_light_gray" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
