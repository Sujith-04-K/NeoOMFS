<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:fitsSystemWindows="true" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".activities.PatientRegistrationActivity">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingVertical="8dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_blue"
                android:padding="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="👨‍⚕️"
                    android:textSize="16sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Neo OMFS"
                    android:textColor="@color/bg_dark_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PATIENT REGISTRATION"
                    android:textColor="@color/accent_blue"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnNotifications"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_bell"
            app:tint="@color/bg_dark_blue" />
    </RelativeLayout>

    <!-- Steps Wizard Progress Indicator -->
    <LinearLayout
        android:id="@+id/layoutSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8FAFC"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <!-- Step 1 (Active) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_nav_active"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Registration"
                android:textColor="@color/bg_dark_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="#E2E8F0" />

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_blue"
                android:backgroundTint="#E2E8F0"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/text_secondary_gray"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="History"
                android:textColor="@color/text_secondary_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="#E2E8F0" />

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_blue"
                android:backgroundTint="#E2E8F0"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/text_secondary_gray"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Diagnostics"
                android:textColor="@color/text_secondary_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="#E2E8F0" />

        <!-- Step 4 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_blue"
                android:backgroundTint="#E2E8F0"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/text_secondary_gray"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Planning"
                android:textColor="@color/text_secondary_gray"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Scrollable Intake Form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintTop_toBottomOf="@id/layoutSteps">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Main Card Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Form Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient Intake &amp; Registration"
                    android:textColor="@color/bg_dark_blue"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Step 1: Primary Demographics and Clinical Baseline"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="13sp" />

                <!-- 1. Full Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="FULL NAME"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="e.g. Johnathan Doe"
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="14sp" />

                <!-- 2. Age -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="AGE"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAge"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="YY"
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="14sp" />

                <!-- 3. Gender (Mock Dropdown Spinner) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="GENDER"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/spinnerGender"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/tvSelectedGender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Male"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_arrow_forward"
                        android:rotation="90"
                        app:tint="@color/text_secondary_gray" />
                </RelativeLayout>

                <!-- 4. Mobile -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="MOBILE"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etMobile"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="+1 (555) 000-0000"
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="14sp" />

                <!-- 5. Address -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ADDRESS"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:gravity="top"
                    android:hint="Street Address, City, Zip Code"
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="14sp" />

                <!-- 6. ASA Physical Status Classification Grid -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="ASA PHYSICAL STATUS CLASSIFICATION"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- ASA Selection Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- ASA I (Active selected state) -->
                    <LinearLayout
                        android:id="@+id/btnAsa1"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_active_blue"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvAsa1Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="I"
                            android:textColor="@color/accent_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAsa1Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Normal Healthy"
                            android:textColor="@color/accent_blue"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ASA II -->
                    <LinearLayout
                        android:id="@+id/btnAsa2"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvAsa2Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="II"
                            android:textColor="@color/bg_dark_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAsa2Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Mild Systemic"
                            android:textColor="@color/text_secondary_gray"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ASA Selection Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- ASA III -->
                    <LinearLayout
                        android:id="@+id/btnAsa3"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvAsa3Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="III"
                            android:textColor="@color/bg_dark_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAsa3Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Severe Systemic"
                            android:textColor="@color/text_secondary_gray"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- ASA IV -->
                    <LinearLayout
                        android:id="@+id/btnAsa4"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvAsa4Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IV"
                            android:textColor="@color/bg_dark_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAsa4Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Life Threatening"
                            android:textColor="@color/text_secondary_gray"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ASA Selection Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- ASA V -->
                    <LinearLayout
                        android:id="@+id/btnAsa5"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvAsa5Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="V"
                            android:textColor="@color/bg_dark_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAsa5Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Moribund"
                            android:textColor="@color/text_secondary_gray"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- ASA VI -->
                    <LinearLayout
                        android:id="@+id/btnAsa6"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_white"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvAsa6Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VI"
                            android:textColor="@color/bg_dark_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAsa6Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Brain-dead"
                            android:textColor="@color/text_secondary_gray"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 7. Procedure Type Dropdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="PROCEDURE TYPE"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/spinnerProcedure"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/tvSelectedProcedure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Third Molar Extraction"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_arrow_forward"
                        android:rotation="90"
                        app:tint="@color/text_secondary_gray" />
                </RelativeLayout>

                <!-- 8. Allergies (Chips + Custom Adder) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="ALLERGIES (KNOWN REACTIONS)"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Outer container to hold chips and input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Flow container for chips -->
                    <LinearLayout
                        android:id="@+id/layoutAllergyChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="8dp">

                        <!-- Penicillin tag -->
                        <LinearLayout
                            android:id="@+id/chipPenicillin"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_chip_allergy"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Penicillin"
                                android:textColor="@color/status_red"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnRemovePenicillin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="✕"
                                android:textColor="@color/status_red"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Latex tag -->
                        <LinearLayout
                            android:id="@+id/chipLatex"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_chip_allergy"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Latex"
                                android:textColor="@color/status_red"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnRemoveLatex"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="✕"
                                android:textColor="@color/status_red"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Add allergy row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etNewAllergy"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edit_text"
                            android:hint="Add allergy..."
                            android:textColorHint="@color/text_light_gray"
                            android:inputType="text"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/btnAddAllergy"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_card_dark_blue"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- 9. Medical History Summary -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="MEDICAL HISTORY SUMMARY"
                    android:textColor="@color/text_secondary_gray"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etMedicalHistory"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text"
                    android:gravity="top"
                    android:hint="Enter high-level medical context, current medications, and pre-existing conditions..."
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="13sp" />

                <!-- Action Button Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <!-- Save Draft Button -->
                    <LinearLayout
                        android:id="@+id/btnSaveDraft"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Save Draft"
                            android:textColor="@color/accent_blue"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Continue to History Button -->
                    <LinearLayout
                        android:id="@+id/btnContinueToHistory"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1.3"
                        android:background="@drawable/bg_button_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Continue to History"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/white" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Bottom info card box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_blue"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/accent_blue" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Data provided in this registration phase will be used to auto-populate surgical risk models."
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar (Assess Active) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Dashboard (Inactive Item) -->
        <FrameLayout
            android:id="@+id/btnNavDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/text_light_gray" />
        </FrameLayout>

        <!-- Patients (Inactive Item) -->
        <FrameLayout
            android:id="@+id/btnNavPatients"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_people"
                app:tint="@color/text_light_gray" />
        </FrameLayout>

        <!-- Assess (Active Item - Dark Blue Capsule Pill) -->
        <LinearLayout
            android:id="@+id/btnNavAssess"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_nav_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_nav_assess"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Assess"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Settings (Inactive Item) -->
        <FrameLayout
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/text_light_gray" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
